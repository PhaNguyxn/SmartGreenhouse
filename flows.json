    "func": "let value = msg.payload;\n\n// Chuyển Buffer thành chuỗi\nif (Buffer.isBuffer(value)) {\n    value = value.toString(\"utf8\");\n}\n\n// Xóa khoảng trắng, xuống dòng và dấu ngoặc thừa\nvalue = String(value)\n    .trim()\n    .replace(/^[\"']|[\"']$/g, \"\")\n    .toLowerCase();\n\nif (\n    value === \"1\" ||\n    value === \"true\" ||\n    value === \"on\"\n) {\n    msg.payload = \"1\";\n    return msg;\n}\n\nif (\n    value === \"0\" ||\n    value === \"false\" ||\n    value === \"off\"\n) {\n    msg.payload = \"0\";\n    return msg;\n}\n\n// Chặn giá trị sai để không đưa vào ui-switch\nnode.warn(\n    \"Trạng thái MQTT không hợp lệ: \" +\n    JSON.stringify(msg.payload)\n);\n\nreturn null;",
